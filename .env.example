# ── Runtime ───────────────────────────────────────────────────────────────────
# Which LLM provider to use. Currently supported: "gemini"
LLM_PROVIDER=gemini

# ── Gemini provider ───────────────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.7-flash

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
APP_PORT=8000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mili

